# Отключаем принудительное использование Visual Studio и Win32
set(CMAKE_GENERATOR "Ninja" CACHE INTERNAL "" FORCE)
unset(CMAKE_GENERATOR_PLATFORM CACHE)
unset(CMAKE_VS_PLATFORM_NAME CACHE)
set(CMAKE_LIBRARY_ARCHITECTURE "x64" CACHE INTERNAL "" FORCE)

# Настраиваем систему
set(CMAKE_SYSTEM_NAME "Windows" CACHE INTERNAL "" FORCE)
set(CMAKE_SYSTEM_VERSION "10.0" CACHE INTERNAL "" FORCE)
set(CMAKE_SYSTEM_PROCESSOR "AMD64" CACHE INTERNAL "" FORCE)
set(CMAKE_VS_PLATFORM_TOOLSET_HOST_ARCHITECTURE "AMD64" CACHE INTERNAL "" FORCE)

# Включаем поддержку многопоточности
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /MP")

# Настраиваем компиляторы для x64
set(VS_ROOT "C:/Program Files (x86)/Microsoft Visual Studio/2019/Community")
set(MSVC_ROOT "${VS_ROOT}/VC/Tools/MSVC/14.29.30133")
set(WIN_SDK "C:/Program Files (x86)/Windows Kits/10")
set(WIN_SDK_VERSION "10.0.19041.0")

set(CMAKE_C_COMPILER "${MSVC_ROOT}/bin/Hostx64/x64/cl.exe" CACHE INTERNAL "" FORCE)
set(CMAKE_CXX_COMPILER "${MSVC_ROOT}/bin/Hostx64/x64/cl.exe" CACHE INTERNAL "" FORCE)
set(CMAKE_RC_COMPILER "${WIN_SDK}/bin/${WIN_SDK_VERSION}/x64/rc.exe" CACHE INTERNAL "" FORCE)
set(CMAKE_MT "${WIN_SDK}/bin/${WIN_SDK_VERSION}/x64/mt.exe" CACHE INTERNAL "" FORCE)
set(CMAKE_SIZEOF_VOID_P 8 CACHE INTERNAL "" FORCE)

# Добавляем пути для инклудов и библиотек MSVC
set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} /I\"${MSVC_ROOT}/include\" /I\"${WIN_SDK}/Include/${WIN_SDK_VERSION}/ucrt\" /I\"${WIN_SDK}/Include/${WIN_SDK_VERSION}/um\" /I\"${WIN_SDK}/Include/${WIN_SDK_VERSION}/shared\"")
set(CMAKE_CXX_FLAGS "${CMAKE_CXX_FLAGS} /I\"${MSVC_ROOT}/include\" /I\"${WIN_SDK}/Include/${WIN_SDK_VERSION}/ucrt\" /I\"${WIN_SDK}/Include/${WIN_SDK_VERSION}/um\" /I\"${WIN_SDK}/Include/${WIN_SDK_VERSION}/shared\"")

# Добавляем пути для библиотек
set(CMAKE_EXE_LINKER_FLAGS "${CMAKE_EXE_LINKER_FLAGS} /LIBPATH:\"${MSVC_ROOT}/lib/x64\" /LIBPATH:\"${WIN_SDK}/Lib/${WIN_SDK_VERSION}/ucrt/x64\" /LIBPATH:\"${WIN_SDK}/Lib/${WIN_SDK_VERSION}/um/x64\"")
set(CMAKE_SHARED_LINKER_FLAGS "${CMAKE_SHARED_LINKER_FLAGS} /LIBPATH:\"${MSVC_ROOT}/lib/x64\" /LIBPATH:\"${WIN_SDK}/Lib/${WIN_SDK_VERSION}/ucrt/x64\" /LIBPATH:\"${WIN_SDK}/Lib/${WIN_SDK_VERSION}/um/x64\"")

# Настройка MFC для GUI
set(CMAKE_MFC_FLAG 2)  # Use MFC in a Shared DLL
add_definitions(-D_AFXDLL)

# Устанавливаем пути для выходных файлов
set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)

# Настройки компонентов
set(BUILD_COM 0)
set(BUILD_WINDOWS_GUI 1)  # Включаем сборку GUI
set(BUILD_DICTS 0)